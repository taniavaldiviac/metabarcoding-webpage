@ARTICLE{Antich2021-vu,
  title     = "Marine biomonitoring with {eDNA}: Can metabarcoding of water
               samples cut it as a tool for surveying benthic communities?",
  author    = "Antich, Adrià and Palacín, Cruz and Cebrian, Emma and Golo, Raül
